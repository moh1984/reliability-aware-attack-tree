# Image references used by docker-compose.yml and scripts/02_zap_scan.ps1.
#
# The published run used the floating tags below. Floating tags move over time,
# so a re-run months later may not use the same build. To reproduce the exact
# published environment, replace each value with the pinned digest recorded in
# results/IMAGE_DIGESTS.md, e.g.
#   DVWA_IMAGE=vulnerables/web-dvwa@sha256:<digest>
#
# Generate that file with:  .\scripts\15_record_digests.ps1
DVWA_IMAGE=vulnerables/web-dvwa:latest
JUICESHOP_IMAGE=bkimminich/juice-shop:latest
WAF_IMAGE=owasp/modsecurity-crs:apache
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
